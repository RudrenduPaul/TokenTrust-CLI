{
  "name": "tokentrust-cli",
  "version": "0.3.2",
  "description": "Vendor-neutral CLI and MCP server that verifies the token and cost savings AI-coding-agent context-reduction proxies (rtk, headroom) actually deliver, measured against a real 23-task labeled corpus with a local tokenizer instead of the proxy's own claimed number.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "tokentrust": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "action",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RudrenduPaul/TokenTrust-CLI.git"
  },
  "keywords": [
    "token-reduction",
    "llm-cost",
    "benchmark",
    "cli",
    "ai-coding-agent",
    "verification",
    "tokenizer",
    "mcp",
    "model-context-protocol",
    "context-window",
    "typescript",
    "regression-testing"
  ],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/RudrenduPaul/TokenTrust-CLI/issues"
  },
  "homepage": "https://github.com/RudrenduPaul/TokenTrust-CLI#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-tiktoken": "^1.0.21",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ip-address": "^10.4.0",
    "nanoid": "^3.3.18"
  }
}
