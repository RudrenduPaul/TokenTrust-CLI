{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RudrenduPaul/tokentrust",
  "description": "Verifies token/cost savings claimed by AI context-reduction proxies via MCP tools.",
  "repository": {
    "url": "https://github.com/RudrenduPaul/TokenTrust",
    "source": "github"
  },
  "version": "0.3.4",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "tokentrust-cli",
      "version": "0.3.4",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "tokentrust-cli"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "script_name",
          "value": "tokentrust"
        },
        {
          "type": "positional",
          "valueHint": "subcommand",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
